# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the admin content import and the reminder cron. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=you@example.com

# Push reminders (generate with: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Vercel Cron sends this as a Bearer token; set the same value in Vercel
CRON_SECRET=change-me

# Optional: Google AI Studio key for scripts/generate-images.mjs
GEMINI_API_KEY=
